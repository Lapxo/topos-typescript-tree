      "place": "topos-node/src/regions/manifest.ts",
      "text": "import { at, found, json, lang, listed, of, sentence, truth, under } from '@lapxo/topos/capsule';\nimport type { Asked } from '@lapxo/topos/capsule';\n\nconst versioned = (text: string | undefined): Record<string, string> => Object.fromEntries((text ?? '').split('|').filter(Boolean)\n  .map((one) => [one.slice(0, one.lastIndexOf('@')), one.slice(one.lastIndexOf('@') + 1)]));\n\n/**\n * The manifest of the tree's copy: what the place holds, read by the tree's own resolver through typesVersions, main and\n * types, and by a resolver asking for sources through the source each subpath was built from. Nothing is a default: a\n * field absent from the place's lines is absent here, and the description is its prose written as its language writes.\n */\nexport const manifest = (asked: Asked): readonly string[] => {\n  const [subpaths, source, what] = [under(asked, 'exports'), at(asked, 'source'), found(asked, `prose/${lang(asked)}/what`)];\n  const resolved = (built: string): Record<string, string> => ({ ...(source ? { source: `./${source}${built.slice(built.indexOf('/'))}.ts` } : {}), types: `./${built}.d.ts`, default: `./${built}.js` });\n  const root = subpaths.find(([sub]) => sub === '')?.[1] ?? '';\n  const [repository, kind, side] = [at(asked, 'repository'), at(asked, 'type'), at(asked, 'sideEffects')];\n  return json({\n    name: at(asked, 'name'), version: at(asked, 'version'), description: what === undefined ? undefined : sentence(asked, of(what, 'about')),\n    ...(kind ? { type: kind } : {}), license: at(asked, 'license'), author: at(asked, 'author'),\n    ...(repository ? { repository: { type: 'git', url: `git+${repository}.git` } } : {}), keywords: (at(asked, 'keywords') ?? '').split('|').filter(Boolean),\n    ...(side === undefined ? {} : { sideEffects: truth(side) }), engines: { node: at(asked, 'engines') },\n    typesVersions: { '*': Object.fromEntries(subpaths.filter(([sub]) => sub !== '').map(([sub, built]) => [sub, [`${built}.d.ts`]])) },\n    exports: { ...Object.fromEntries(subpaths.map(([sub, built]) => [sub === '' ? '.' : `./${sub}`, resolved(built)])), [`./${asked.shape}`]: `./${asked.shape}` },\n    files: listed(asked, 'audit/wire/ships'), scripts: Object.fromEntries(under(asked, 'scripts').filter(([name]) => name !== '')),\n    ...(at(asked, 'dependencies') === undefined ? {} : { dependencies: versioned(at(asked, 'dependencies')) }), devDependencies: versioned(at(asked, 'devDependencies')),\n    main: `${root}.js`, types: `${root}.d.ts`,\n  });\n};\n"
     }
    ]
